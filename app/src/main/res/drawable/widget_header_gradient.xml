<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部状态栏 - 呼吸光晕渐变 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：深蓝到紫色渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E3A8A"
                android:centerColor="#3B82F6"
                android:endColor="#6366F1"
                android:type="linear" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>

    <!-- 顶层：玻璃质感高光 -->
    <item android:top="0dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>

</layer-list>
