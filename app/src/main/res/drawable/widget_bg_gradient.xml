<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：深色渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0A0E27"
                android:centerColor="#161830"
                android:endColor="#1F1640"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 蓝色对角光晕（左上→右下扩散，无明显圆心） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#303B82F0"
                android:centerColor="#103B82F0"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 紫色对角光晕（右下→左上扩散，与蓝色形成对角线呼应） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#306366F1"
                android:centerColor="#106366F1"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 内部边框高光（向内缩 1dp 形成细边，不会产生窄长条） -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>

</layer-list>
