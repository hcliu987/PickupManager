<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作按钮：蓝色玻璃胶囊（无外发光，避免与背景冲突） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 主体 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#60A5FA"
                android:centerColor="#3B82F6"
                android:endColor="#2563EB"
                android:type="linear" />
            <corners android:radius="13dp" />
            <stroke
                android:width="1dp"
                android:color="#50FFFFFF" />
        </shape>
    </item>

    <!-- 顶部高光 -->
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp" />
        </shape>
    </item>

</layer-list>
