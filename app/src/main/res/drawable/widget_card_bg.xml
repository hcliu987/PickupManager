<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃质感卡片背景 - 强化版 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：半透明深色玻璃基底（向内缩 1.5dp，避开 ListView 边界裁剪） -->
    <item
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#30FFFFFF"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="0dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>

    <!-- 顶层：顶部高光，模拟玻璃反光 -->
    <item android:top="1.5dp" android:bottom="22dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- 内部蓝色微光（左上角光晕暗示） -->
    <item android:width="40dp" android:height="40dp" android:gravity="top|start" android:top="1.5dp" android:left="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#203B82F6"
                android:gradientRadius="40"
                android:startColor="#003B82F6"
                android:endColor="#003B82F6"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
