<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 添加小部件 - 3×3 标准尺寸（默认推荐） -->
    <shortcut
        android:shortcutId="add_widget_3x3"
        android:shortcutShortLabel="@string/shortcut_add_widget_short"
        android:shortcutLongLabel="@string/shortcut_add_widget_long"
        android:shortcutDisabledMessage="@string/shortcut_add_widget_disabled"
        android:icon="@drawable/ic_shortcut_widget">
        <intent
            android:action="com.shanqiu.pickupmanager.action.ADD_WIDGET"
            android:targetPackage="com.shanqiu.pickupmanager"
            android:targetClass="com.shanqiu.pickupmanager.widget.ShortcutTrampolineActivity">
            <extra android:name="widget_size" android:value="3x3" />
        </intent>
    </shortcut>

